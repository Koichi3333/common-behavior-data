        def DomeLight "dome"
        {
            float inputs:intensity = 1200
        }

        def RectLight "key"
        {
            float inputs:height = 2.6
            float inputs:intensity = 16000
            float inputs:width = 2.6
            float3 xformOp:rotateXYZ = (-50, 0, -32)
            double3 xformOp:translate = (-1.8, -2.6, 3.1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        }

