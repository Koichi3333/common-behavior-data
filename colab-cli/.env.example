# Local machines: copy to colab-cli/.env (gitignored) and fill in what you use.
# tools/colab_secrets.py reads it; Codespaces users set Codespaces secrets instead.
#
#   cp colab-cli/.env.example colab-cli/.env && chmod 600 colab-cli/.env
#
# Then, once per session:
#   python3 colab-cli/tools/colab_secrets.py -s cbd GEMINI_API_KEY

# Optional: captions and object re-classification in generators/video_to_cbd
GEMINI_API_KEY=
