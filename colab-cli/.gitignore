# Everything the Colab CLI workflow produces stays out of git.
# (The repository root .gitignore already covers *.zip, .env, .env.*,
# __pycache__/ and .ipynb_checkpoints/.)

# Working directory: run notebooks from here; outputs land here.
# Only the placeholder is tracked so the directory exists after a clone.
ws/*
!ws/.gitkeep

# `colab exec -f X.ipynb` writes X_output.ipynb next to the input. It is the
# same notebook with outputs baked in -- including anything a cell printed.
*_output.ipynb

# Keys. Local: put them in colab-cli/.env (see .env.example).
!.env.example
secrets.json
*.secrets.json
.secrets.json

# Generated by setup.sh from `colab skill`, so it matches the installed CLI.
.claude/skills/colab-operator/

# drivemount / auth run under tools/ptyrun.py
*.pty.log
dm.log
dm.in
